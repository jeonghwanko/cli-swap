{
  "name": "cli-swap",
  "version": "0.1.0",
  "description": "Multi-chain token swap CLI for humans and AI agents. Powered by Li.Fi SDK (60+ chains).",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "cli-swap": "dist/index.js",
    "cli-swap-mcp": "dist/mcp-server.js",
    "cli-swap-api": "dist/http-server.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "mcp": "tsx src/mcp-server.ts",
    "api": "tsx src/http-server.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "swap",
    "defi",
    "cli",
    "multi-chain",
    "lifi",
    "ethereum",
    "solana",
    "token",
    "mcp",
    "ai-agent",
    "openclaw",
    "telegram"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jeonghwanko/cli-swap.git"
  },
  "homepage": "https://github.com/jeonghwanko/cli-swap#readme",
  "files": [
    "dist",
    "openclaw-skill",
    "examples",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@lifi/sdk": "^3.5.0",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "@solana/web3.js": "^1.98.0",
    "chalk": "^5.4.1",
    "commander": "^13.1.0",
    "ethers": "^6.13.5",
    "express": "^5.2.1",
    "inquirer": "^12.4.2",
    "ora": "^8.2.0",
    "viem": "^2.23.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/inquirer": "^9.0.7",
    "@types/node": "^22.13.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.0"
  }
}
